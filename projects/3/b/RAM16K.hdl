// File name: projects/3/b/RAM16K.hdl
/**
 * Memory of 16K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    DMux4Way(
        in=load,
        sel=address[0..1],
        a=dMuxOut0,
        b=dMuxOut1,
        c=dMuxOut2,
        d=dMuxOut3
    );
    RAM4K(in=in, load=dMuxOut0, address=address[2..13], out=r0);
    RAM4K(in=in, load=dMuxOut1, address=address[2..13], out=r1);
    RAM4K(in=in, load=dMuxOut2, address=address[2..13], out=r2);
    RAM4K(in=in, load=dMuxOut3, address=address[2..13], out=r3);
    Mux4Way16(
        a=r0,
        b=r1,
        c=r2,
        d=r3,
        sel=address[0..1],
        out=out
    );
}
