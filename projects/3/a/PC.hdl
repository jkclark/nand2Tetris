// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], inc, load, reset;
    OUT out[16];
    
    PARTS:
    // HINT:
    // inc, load, reset are "sel" values for Mux's
    Inc16(in=regOut, out=incrementedVal);
    Mux16(a=in, b=incrementedVal, sel=inc, out=incOut);
    Mux16(a=incOut, b=in, sel=load, out=loadOut);
    Mux16(a=loadOut, b=false, sel=reset, out=finalLoadValue);

    Or(a=reset, b=load, out=or1);
    Or(a=or1, b=inc, out=finalLoad);
    Register(in=finalLoadValue, load=finalLoad, out=out, out=regOut);
}
