// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    // Zero x/y if necessary
    Mux16(a=x, b=false, sel=zx, out=xAfterZx);
    Mux16(a=y, b=false, sel=zy, out=yAfterZy);

    // Prepare bitwise NOT for (potentially zeroed) x/y
    Not16(in=xAfterZx, out=notXAfterZx);
    Not16(in=yAfterZy, out=notYAfterZy);

    // Bitwise NOT x/y
    Mux16(a=xAfterZx, b=notXAfterZx, sel=nx, out=xAfterNx);
    Mux16(a=yAfterZy, b=notYAfterZy, sel=ny, out=yAfterNy);

    // Prepare +/& output
    Add16(a=xAfterNx, b=yAfterNy, out=addedXY);
    And16(a=xAfterNx, b=yAfterNy, out=andedXY);

    // Select +/& output
    Mux16(a=andedXY, b=addedXY, sel=f, out=preResult);

    // Prepare bitwise NOT for result
    Not16(in=preResult, out=notResult);

    // Bitwise NOT result
    Mux16(
        a=preResult,
        b=notResult,
        sel=no,
        out=out,
        out[0..7]=finalResultHalf1,
        out[8..15]=finalResultHalf2,
        out[15]=ng  // Handle ng here
    );


    // zr
    Or8Way(in=finalResultHalf1, out=halfOr1);
    Or8Way(in=finalResultHalf2, out=halfOr2);
    Or(a=halfOr1, b=halfOr2, out=orFinalResult);
    Not(in=orFinalResult, out=zr);
}
